// Cloudflare Workers(GitHub 連動)部署設定。
// Build command: npm run build / Deploy command: npx wrangler deploy
// worker/index.js 提供零知識短連結 API(/api/s);未綁定 KV 時回 503,
// 前端自動退回長連結。詳見 docs/SHORTLINK.md。
// 注意:kv_namespaces 的 "id" 必須是 32 碼十六進位 namespace ID
//(`npx wrangler kv namespace list` 可查),填名稱會得到部署錯誤 10042。
{
  "name": "snapdeck",
  "compatibility_date": "2026-07-13",
  // 只走自訂網域 snapdeck.ai-apps.work:關閉 *.workers.dev 直達網址
  // 與 preview 版本網址(避免繞過網域層設定/多一個可被掃描的入口)。
  "workers_dev": false,
  "preview_urls": false,
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "LINKS", "id": "1dd64f786c2547beb2971a5600c64b90" }
  ],
  // POST /api/s 誰都能打(零知識短連結沒有帳號可綁),所以寫入要有閘門:
  // 每 IP 每分鐘 5 次,加上全站每天 500 次。放在 DO 裡是因為 input gate 讓
  // 「讀計數 → 判斷 → 加一」是原子的;在 Worker 裡做就是 read-then-act。
  // 撞上限時前端會自動退回長連結,站不會壞。細節見 worker/index.js。
  "durable_objects": {
    "bindings": [{ "name": "WRITE_GATE", "class_name": "WriteGate" }]
  },
  // SQLite-backed DO:Free plan 也能用。
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WriteGate"] }]
}
